# =====================================================
# DATABASE CONFIGURATION (Choose ONE option)
# =====================================================

# OPTION 1: Neon PostgreSQL (RECOMMENDED - FREE 10GB)
# Get this from: https://neon.tech (no credit card required)
# 1. Create account at neon.tech
# 2. Create new project
# 3. Copy the connection string
# 4. Paste it below
DATABASE_URL="postgresql://user:password@ep-xxx.neon.tech/dbname?sslmode=require"
VITE_DATABASE_URL="postgresql://user:password@ep-xxx.neon.tech/dbname?sslmode=require"

# OPTION 2: Supabase (if you still want to use it)
# Get these from: https://app.supabase.com
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-key-here"

# =====================================================
# OPTIONAL: GEMINI AI API (for AI features)
# =====================================================
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# =====================================================
# OPTIONAL: APPLICATION URL
# =====================================================
APP_URL="http://localhost:3000"
