# =====================================================
# SUPABASE CLOUD DATABASE CONFIGURATION
# =====================================================
# These are REQUIRED for centralized database access across all devices
# Get these from your Supabase Dashboard: https://app.supabase.com
# 
# Setup Instructions:
# 1. Create a new Supabase project at https://app.supabase.com
# 2. Go to Project Settings > API
# 3. Copy your Project URL and paste it below
# 4. Copy your anon/public key and paste it below
# 5. Run the supabase_schema.sql in the SQL Editor to create tables
# 6. Rename this file to .env
#
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-key-here"

# =====================================================
# OPTIONAL: GEMINI AI API (for AI features)
# =====================================================
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# =====================================================
# OPTIONAL: APPLICATION URL
# =====================================================
APP_URL="http://localhost:3000"
